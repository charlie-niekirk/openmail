---
source: crates/openmail-ui/src/body_document.rs
expression: doc
---
<!DOCTYPE html>
<html><head><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src data:; style-src 'unsafe-inline'; font-src data:; form-action 'none'; base-uri 'none'"><meta name="viewport" content="width=device-width, initial-scale=1"><style>:root{color-scheme:light;--om-bg:#ffffff;--om-fg:#1f1f1f;--om-border:#e3e5e8;--om-muted:#5f6368;--om-muted-bg:#f1f3f4;--om-hover:#f2f6fc;--om-link:#0b57d0;--om-focus:#0b57d0}html,body{margin:0;padding:0;background:var(--om-bg);color:var(--om-fg)}body{font:14px/1.45 -apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;overflow-wrap:break-word}img{max-width:100%}.om-thread{max-width:860px;min-width:min-content;margin:0 auto;padding:4px 24px 24px;box-sizing:border-box}.om-message{border:1px solid var(--om-border);border-radius:8px;margin:0 0 12px;overflow:hidden}.om-header{display:block;list-style:none;cursor:pointer;padding:8px 16px}.om-header::-webkit-details-marker{display:none}.om-header:focus-visible{outline:2px solid var(--om-focus);outline-offset:-2px}.om-header:hover{background:var(--om-hover)}.om-message[open]>.om-header{padding-top:12px}.om-header-row{display:flex;align-items:baseline;gap:12px}.om-sender{flex:none;max-width:220px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.om-line{flex:1 1 0;width:0;min-width:0;color:var(--om-muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.om-date{flex:none;color:var(--om-muted);font-size:12px}.om-message:not([open]) .om-recipients,.om-message[open] .om-snippet{display:none}.om-participants{padding:0 16px 12px;color:var(--om-muted);font-size:13px}.om-participants table{border-collapse:collapse}.om-participants th{font-weight:normal;text-align:left;vertical-align:top;padding:0 8px 0 0;width:36px}.om-participants td{padding:0;color:var(--om-fg)}.om-body{padding:12px 16px 16px;border-top:1px solid var(--om-border);contain:paint}.om-mail{overflow-wrap:anywhere}.om-mail a{color:var(--om-link)}.om-mail img{max-width:min(100%,calc(100vw - 82px));height:auto}.om-dark .om-card{--om-fg:#1f1f1f;--om-muted:#5f6368;--om-muted-bg:#f1f3f4;--om-border:#e3e5e8;--om-link:#0b57d0;color-scheme:light;background:#ffffff;color:var(--om-fg);padding:16px;border-radius:6px}.om-dark .om-card img{max-width:min(100%,calc(100vw - 114px))}.om-text{white-space:pre-wrap}.om-notice{margin:0;color:var(--om-muted)}</style></head><body><main class="om-thread">
<details class="om-message" id="m-m1"><summary class="om-header"><div class="om-header-row"><span class="om-sender">Ada &lt;Lovelace&gt;</span><span class="om-line"><span class="om-recipients">to me</span><span class="om-snippet">Tea &amp; cake?</span></span><span class="om-date">Nov 3</span></div></summary><div class="om-participants"><table><tr><th>from</th><td>Ada &lt;ada@example.com&gt;</td></tr><tr><th>to</th><td>me@example.com</td></tr><tr><th>date</th><td>Tue, Nov 3, 2026, 3:07 PM</td></tr></table></div><div class="om-body"><div class="om-text">First
  line</div></div></details>
<details class="om-message" id="m-m2"><summary class="om-header"><div class="om-header-row"><span class="om-sender">Ada &lt;Lovelace&gt;</span><span class="om-line"><span class="om-recipients">to me</span><span class="om-snippet">Tea &amp; cake?</span></span><span class="om-date">Nov 3</span></div></summary><div class="om-participants"><table><tr><th>from</th><td>Ada &lt;ada@example.com&gt;</td></tr><tr><th>to</th><td>me@example.com</td></tr><tr><th>date</th><td>Tue, Nov 3, 2026, 3:07 PM</td></tr></table></div><div class="om-body"><p class="om-notice">Loading message…</p></div></details>
<details class="om-message" id="m-m3" open><summary class="om-header"><div class="om-header-row"><span class="om-sender">Ada &lt;Lovelace&gt;</span><span class="om-line"><span class="om-recipients">to me</span><span class="om-snippet">Tea &amp; cake?</span></span><span class="om-date">Nov 3</span></div></summary><div class="om-participants"><table><tr><th>from</th><td>Ada &lt;ada@example.com&gt;</td></tr><tr><th>to</th><td>me@example.com</td></tr><tr><th>date</th><td>Tue, Nov 3, 2026, 3:07 PM</td></tr></table></div><div class="om-body"><p class="om-notice">You&#39;re offline.</p></div></details>
<details class="om-message" id="m-m4" open><summary class="om-header"><div class="om-header-row"><span class="om-sender">Ada &lt;Lovelace&gt;</span><span class="om-line"><span class="om-recipients">to me</span><span class="om-snippet">Tea &amp; cake?</span></span><span class="om-date">Nov 3</span></div></summary><div class="om-participants"><table><tr><th>from</th><td>Ada &lt;ada@example.com&gt;</td></tr><tr><th>to</th><td>me@example.com</td></tr><tr><th>date</th><td>Tue, Nov 3, 2026, 3:07 PM</td></tr></table></div><div class="om-body"><div class="om-mail" id="b-m4"><p style="color:red">Hi</p></div></div></details>
</main></body></html>
